+/* Evaluate cross-LFO modulation from the previous block. User parameters stay
+ * bases between ticks, so save, undo, scenes, disable and retarget cannot bake
+ * modulation into a setting. The one-block delay also makes cyclic routes
+ * independent of slot iteration order. */
+static inline void lfo_cross_begin(lfo_state_t *lfos, float base[LFO_COUNT][3]) {
+    for (int index=0; index<LFO_COUNT; index++) {
+        base[index][0]=lfos[index].depth;
+        base[index][1]=lfos[index].rate_hz;
+        base[index][2]=lfos[index].phase_offset;
+    }
+    for (int index=0; index<LFO_COUNT; index++) {
+        lfo_state_t *source=&lfos[index];
+        if (!source->enabled || !source->previous_valid ||
+            source->target[0]!='l' || source->target[1]!='f' || source->target[2]!='o' ||
+            source->target[3]<'1' || source->target[3]>'2' || source->target[4]) continue;
+        int target=source->target[3]-'1';
+        if (target==index) continue;
+        int field=-1;
+        if (!strcmp(source->param,"depth")) field=0;
+        else if (!strcmp(source->param,"rate_hz")) field=1;
+        else if (!strcmp(source->param,"phase_offset")) field=2;
+        if (field<0) continue;
+        float minimum=field==0?-1.0f:field==1?0.1f:0.0f;
+        float maximum=field==1?20.0f:1.0f;
+        float signal=source->bipolar?source->previous_signal:(source->previous_signal+1.0f)*0.5f;
+        float scale=(maximum-minimum)*(source->bipolar?0.5f:1.0f);
+        float value=base[target][field]+signal*base[index][0]*scale;
+        value=fminf(maximum,fmaxf(minimum,value));
+        if (field==0) lfos[target].depth=value;
+        else if (field==1) lfos[target].rate_hz=value;
+        else lfos[target].phase_offset=value;
+    }
+}
+static inline void lfo_cross_end(lfo_state_t *lfos, const float base[LFO_COUNT][3]) {
+    for (int index=0; index<LFO_COUNT; index++) {
+        lfos[index].depth=base[index][0];
+        lfos[index].rate_hz=base[index][1];
+        lfos[index].phase_offset=base[index][2];
+    }
+}
