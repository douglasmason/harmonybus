+
+/* HarmonyBus source bank: Movy indices 4..7 == user tracks 5..8.
+ * Their Mute button is deliberately AUDIO ONLY. Sequenced/live MIDI must keep
+ * traversing the chain so HarmonyBus can continue rendering native tracks. */
+const HB_SOURCE_FIRST = 4;
+const HB_SOURCE_LAST = 7;
+const sourceAudioMuted: boolean[] = new Array(TRACK_COUNT).fill(false) as boolean[];
+
+function isHbSourceTrack(track: number): boolean {
+    return track >= HB_SOURCE_FIRST && track <= HB_SOURCE_LAST;
+}
@@
 export function isSoloed(track: number): boolean { return solo[track] === true; }
 export function anySolo(): boolean { return anySoloOn(); }
 /* What the user asked for, ignoring solo — the state a mute toggle flips. */
