     return base ? base[track] : seqState.muted[track];
 }
+
+function setSourceAudioMute(track: number, want: boolean): void {
+    const mix = readMix(track);
+    if (mix.muted === want && sourceAudioMuted[track] === want) return;
+    mix.muted = want;
+    /* Prototype source-bank mute is intentionally outside Movy's sequencer
+     * undo domain: write the chain mixer directly so undo can never restore
+     * the audio bit while leaving our LED/cache stale. The mix value itself is
