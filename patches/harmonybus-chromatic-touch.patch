+static void hb_set_chromatic_touch(Inst *instance,int direction,int down){
+    if(!instance||(direction!=-1&&direction!=1))return;
+    uint8_t *held=direction<0?&instance->chromatic_below_held:&instance->chromatic_above_held;
+    if(down){
+        /* Repeated On while the same finger remains down is not a new gesture.
