+        instance->chromatic_touch_direction=direction;
+        instance->chromatic_touch_consumed=0;
+        return;
+    }
+    *held=0;
+    if(instance->chromatic_touch_direction==direction){
+        instance->chromatic_touch_direction=0;
+        instance->chromatic_touch_consumed=0;
+    }
+}
+static int hb_take_chromatic_touch(Inst *instance){
